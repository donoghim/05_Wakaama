# Public IP address or FQDN reachable by LwM2M devices.
PUBLIC_ENDPOINT=lwm2m.example.com

# Published host ports. The LwM2M port is written into the initial bootstrap URI.
BOOTSTRAP_HOST_PORT=22101
LWM2M_HOST_PORT=22102
DASHBOARD_PORT=8080

# Keep the unauthenticated dashboard local by default. Set 0.0.0.0 only behind
# a firewall, VPN, or authenticated reverse proxy.
DASHBOARD_BIND_ADDRESS=127.0.0.1

# Seed values used only when docker-data/config/01_bs_plain.ini does not exist.
BOOTSTRAP_LIFETIME=7200
DFOTA_HOST=lwm2m.example.com
DFOTA_URI_PREFIX=/dfota_fw
WAKAAMA_COMMERCIAL_SERVER_MODE=1